{
  "manifest_version": 3,
  "name": "Orbit Memory",
  "version": "1.0.0",
  "description": "Save conversations from selected AI sites to your local Orbit library.",
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "action": {
    "default_title": "Orbit Memory",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
